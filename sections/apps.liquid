<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- for block in section.blocks -%}
    <div class="lazy-app-block" style="min-height: 100px;">
      <template>
        {% render block %}
      </template>
    </div>
  {%- endfor -%}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const lazyAppBlocks = document.querySelectorAll('.lazy-app-block');

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const template = entry.target.querySelector('template');
              if (template) {
                const content = template.content.cloneNode(true);
                entry.target.innerHTML = '';
                entry.target.appendChild(content);
                obs.unobserve(entry.target);
              }
            }
          });
        },
        { rootMargin: '0px 0px 200px 0px' }
      );

      lazyAppBlocks.forEach((block) => {
        observer.observe(block);
      });
    });
  </script>
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
